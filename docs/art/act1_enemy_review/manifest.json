{
 "title": "Act I enemy AoE art (Covenant telegraphs, holy ground, Seraphine's hazards)",
 "note": "All pieces are procedural pixel art made by tools/covenant_aoe_art.py (no image generation) and drawn by scripts/fx/covenant_fx.gd: band and hatch tiles at 1:1 along the exact danger edge (any radius, length or angle), discs baked at the radii the game uses. Images are at 1x and x4 (x2 for the big discs) nearest-neighbour on the Graveyard soil colour; strips also as GIFs. Before / after crops are 1:1 game-size (1280x720 layout) frames of the same seeded autotest moments under xvfb (before = integration 3227eea, after = this branch). Not caught in a shot window and left for the owner's playtest: the boss death flash, the Vael and Sentinel crescent strips, the structure break strip, the zone-change smoke, the High Confessor pillar, the Sister's lash, the Guardian's raised fists, Seraphine's beams, teleport mark and Avatar / Last Light aura.",
 "runs": {
  "R1": "--seed=1337 --stage=graveyard --policy=army",
  "R2": "--seed=1337 --stage=crimson_march --policy=naive",
  "R3": "--seed=1337 --stage=sanctum --policy=naive --spawn=high_confessor@200x2,radiant_inquisitor@260x2,sun_paladin@330x2,sanctified_sentinel@230x3,battle_sister@240x4",
  "R4": "--seed=7 --stage=sanctum --policy=naive --spawn=high_confessor@40x3,battle_sister@42x4,sanctified_sentinel@44x3,sun_paladin@46x2,radiant_inquisitor@48x2",
  "R5": "--seed=1337 --stage=sanctum --policy=army --meta=max",
  "R6": "R1 again after the Wrath halo redraw fix",
  "all": "xvfb-run ... --rendering-driver opengl3 --resolution 1280x720 --fixed-fps 60 -- --autotest --speed=16 --art-shots=T,... --shot-dir=DIR"
 },
