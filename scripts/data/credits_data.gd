## CreditsData — content and motion of the Credits screen (CreditsScreen;
## GDD §15.0 "Credits screen"). Data only, no logic. Names only what is
## true of the project (owner rule: do not invent people): the studio name
## from export_presets.cfg, Godot Engine and its MIT licence (Godot asks
## every game to include it), the two fonts under the SIL Open Font License
## 1.1, the synthesized audio and a generic thank-you to the playtesters.
class_name CreditsData
extends RefCounted

## The credits roll, top to bottom: [kind, text] rows. Kinds:
##   "logo"    the NECROPATHY logo (UiArtData.LOGO), text unused,
##   "label"   a LABEL-tier section label (upper case, dim),
##   "header"  a HEADER-tier name (gold),
##   "name"    a NAME-tier line (bone),
##   "body"    a BODY-tier line (dim, wraps),
##   "divider" an ornamented skull divider, text unused,
##   "gap"     an empty gap of GAP px, text unused,
##   "title"   a TITLE-tier line (Jacquard, gold).
const ROLL: Array = [
	["logo", ""],
	["gap", ""],
	["label", "A game by"],
	["header", "Smoketsu"],  # export_presets.cfg application/company_name
	["divider", ""],
	["label", "Made with"],
	["header", "Godot Engine"],
	["body", "godotengine.org"],
	["body", "Godot Engine is free and open-source software under the MIT licence. Its full text and the notices of its third-party parts are on the Licences page."],
	["divider", ""],
	["label", "Fonts"],
	["name", "Jersey 10"],
	["body", "Copyright 2023 The Soft Type Project Authors"],
	["name", "Jacquard 24"],
	["body", "Copyright 2023 The Soft Type Project Authors"],
	["body", "Both under the SIL Open Font License 1.1 (on the Licences page)."],
	["divider", ""],
	["label", "Music and sound"],
	["name", "Synthesized in-engine"],
	["body", "Every note and sound effect is generated by the game itself at startup."],
	["divider", ""],
	["label", "Playtesters"],
	["body", "To everyone who played early builds and told us what they found: thank you."],
	["gap", ""],
	["gap", ""],
	["title", "Thanks for playing"],
	["gap", ""],
]

## The font licence files shipped with the game (export include_filter
## "assets/fonts/*.txt"): [font name, file]. Their first line is the
## copyright line; the licence text is shown once (both are OFL 1.1).
const FONT_LICENCES: Array = [
	["Jersey 10", "res://assets/fonts/OFL-Jersey10.txt"],
	["Jacquard 24", "res://assets/fonts/OFL-Jacquard24.txt"],
]

## Pages (tab buttons): [page id, button text].
const PAGES: Array = [["credits", "Credits"], ["licences", "Licences"]]  # TUNING (not in GDD)
## Screen title.
const TITLE: String = "Credits"  # TUNING (not in GDD)
## Licences page section headers.
const GODOT_HEADER: String = "Godot Engine"  # TUNING (not in GDD)
## Header of the font licence section.
const FONTS_HEADER: String = "Fonts: SIL Open Font License 1.1"  # TUNING (not in GDD)
## Header of the third-party list.
const THIRD_PARTY_HEADER: String = "Godot's third-party components"  # TUNING (not in GDD)
## Header of the licence texts under the list.
const LICENCE_TEXTS_HEADER: String = "Licence texts"  # TUNING (not in GDD)

# --- Layout and motion (layout px, seconds; TUNING, not in GDD) -----------------

## Opacity (0..1) of the backdrop over the main menu (hides its hint strip).
const BACKDROP_ALPHA: float = 0.96  # TUNING (not in GDD)
## Outer size of the ornate panel (px).
const PANEL_SIZE := Vector2(780.0, 620.0)  # TUNING (not in GDD)
## Size (px) of a page tab button.
const TAB_SIZE := Vector2(130.0, 40.0)  # TUNING (not in GDD)
## Size (px) of the Back button.
const BACK_SIZE := Vector2(110.0, 40.0)  # TUNING (not in GDD)
## Inset (px) of a roll divider from each side of the column.
const DIVIDER_INSET: int = 120  # TUNING (not in GDD)
## Width of the text column (px).
const COLUMN_WIDTH: float = 620.0  # TUNING (not in GDD)
## Height of a "gap" row (px).
const GAP: float = 28.0  # TUNING (not in GDD)
## Auto-scroll speed of the credits roll (px per second, real time).
const SCROLL_SPEED: float = 24.0  # TUNING (not in GDD)
## Seconds the roll rests at the top before it starts to move.
const START_DELAY: float = 1.6  # TUNING (not in GDD)
## Pixels one Up / Down press (or a held stick, per repeat) scrolls a page.
const SCROLL_STEP: float = 60.0  # TUNING (not in GDD)
